# Copy to .env.local (npm run setup:env does it and generates AUTH_SECRET).
# Never commit .env.local. Step-by-step guide: http://127.0.0.1:3000/setup
# Restart the dev server after changing this file.

# Spotify app credentials: https://developer.spotify.com/dashboard > your app > Settings
# Client ID (32 hex characters)
AUTH_SPOTIFY_ID=
# Client secret ("View client secret"). Keep it private.
AUTH_SPOTIFY_SECRET=

# Random string (32+ characters) that encrypts the session cookie.
# Generate with: npm run setup:env, the button on /setup, or: npx auth secret
AUTH_SECRET=

# Base URL of the app. Always 127.0.0.1 (Spotify rejects localhost redirect URIs).
# Redirect URI to register in the Spotify Dashboard: http://127.0.0.1:3000/api/auth/callback/spotify
AUTH_URL=http://127.0.0.1:3000

# Last.fm API key (genres come from Last.fm tags): https://www.last.fm/api/account/create
# Use the "API key", not the "Shared secret".
LASTFM_API_KEY=
